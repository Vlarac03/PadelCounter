{
  "app": {
    "bundleName": "com.vlarac.padelcounter",
    "vendor": "Vlarac",
    "version": {
      "code": 111,
      "name": "1.1.1"
    }
  },
  "deviceConfig": {
    "default": {
      "keepAlive": false
    }
  },
  "module": {
    "deviceType": [
      "liteWearable"
    ],
    "distro": {
      "deliveryWithInstall": true,
      "moduleName": "entry",
      "moduleType": "entry"
    },
    "abilities": [
      {
        "name": ".MainAbility",
        "srcLanguage": "js",
        "srcPath": "MainAbility",
        "icon": "$media:icon",
        "description": "$string:MainAbility_desc",
        "label": "$string:MainAbility_label",
        "type": "page",
        "visible": true
      }
    ],
    "js": [
      {
        "pages": [
          "pages/index/index"
        ],
        "name": ".MainAbility",
        "window": {
          "designWidth": 454,
          "autoDesignWidth": false
        }
      }
    ]
  }
}