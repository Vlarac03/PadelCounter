<swiper class="full-screen" index="0" vertical="false" indicator="false">

    <div class="container">
        <div class="container win-page" if="{{isMatchOver && showWinPage}}">
            <text class="win-title">MATCH OVER</text>
            <text class="win-team">{{winner === 'A' ? 'YOU WIN!' : 'OPP WINS!'}}</text>
            <text class="win-score">{{setsA}} - {{setsB}}</text>

            <div class="win-btn" onclick="closeWinPage" style="background-color: #444444;">
                <text class="win-btn-text">VIEW STATS</text>
            </div>

            <div class="win-btn" onclick="resetMatch" style="background-color: #cc2222;">
                <text class="win-btn-text">RESET MATCH</text>
            </div>
        </div>

        <div class="container" if="{{!isMatchOver || !showWinPage}}">
            <div class="section-opp" onclick="addPointB">
                <text class="score-opp">{{pointsB}}</text>
            </div>

            <div class="center-bar">
                <div class="btn-box" onclick="undoPoint">
                    <text class="btn-txt">←</text>
                </div>
                <text class="info-text">{{setsA}} - {{setsB}} | {{gamesA}} - {{gamesB}}</text>
                <div class="btn-box" onclick="resetMatch">
                    <text class="btn-txt">R</text>
                </div>
            </div>

            <div class="section-me" onclick="addPointA">
                <text class="score-me">{{pointsA}}</text>
            </div>
        </div>
    </div>

    <div class="container menu-page">
        <text class="menu-title-small">HISTORY</text>
        <text class="history-item">{{h1}}</text>
        <text class="history-item">{{h2}}</text>
        <text class="history-item">{{h3}}</text>
        <text class="history-item" if="{{maxSets == 5}}">{{h4}}</text>
        <text class="history-item" if="{{maxSets == 5}}">{{h5}}</text>
    </div>

    <div class="container menu-page">
        <text class="menu-title-small">SETTINGS</text>

        <div class="menu-item" onclick="toggleGoldenPoint">
            <text class="menu-text">Golden Point: {{goldenPoint ? 'ON' : 'OFF'}}</text>
        </div>

        <div class="menu-item" onclick="toggleMaxSets">
            <text class="menu-text">Match to: {{maxSets}} Sets</text>
        </div>

        <text class="footer-text">Developed by Vlarac</text>
    </div>
</swiper>
